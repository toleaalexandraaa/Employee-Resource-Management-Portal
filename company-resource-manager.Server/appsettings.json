{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CompanyResourceManager;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  },
  "JwtSettings": {
    "Secret": "CHANGE_THIS_TO_A_32+_CHARACTER_SECRET_KEY_FOR_PRODUCTION",
    "Issuer": "CompanyResourceManager",
    "Audience": "CompanyResourceManagerClient",
    "AccessTokenExpiryMinutes": 480,
    "RefreshTokenExpiryDays": 7
  },
  "EstimationSettings": {
    "ModelDirectory": "ML/Models"
  }
}
